# The probe-explorer payload is shipped as a Release asset and pulled in by
# .github/workflows/pages.yml at deploy time, NOT committed: it is ~156 MB of
# PNG rasters that do not delta-compress, so committing it would grow .git
# permanently on every re-export.
probes-payload.tar.gz
# no trailing slash: that form matches only real directories, and a symlink
# to the payload (handy for local preview) would slip through as untracked
assets/interactive/data/probes
upload_payload.sh
